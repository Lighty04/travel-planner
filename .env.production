# Database (system PostgreSQL - peer auth)
DATABASE_URL="postgresql://decisionhelper:@localhost:5432/travel_planner?host=/var/run/postgresql"

# Auth (Google OAuth)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
NEXTAUTH_SECRET="travel-planner-secret-change-in-production"
NEXTAUTH_URL="http://192.168.0.16:3000"

# External APIs
RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY_HERE

# Server
PORT=3000
